\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Comparative Performance Analysis}{20}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Temporal evolution of mean trust scores for benign (solid) and malicious (dashed) UAVs under $M = 2, 5, 10$ Thinker Agents. Key observations: (1) separation onset delays with more agents but final margin increases; (2) dormant attackers (switching at ${\sim }1300$~s) lose ${\sim }1.5$ trust units within 600~s; (3) after 3500~s, all configurations reach quasi-steady-state with residual fluctuation $\pm 0.3$ due to mobility-induced observation gaps.}}{21}{figure.caption.6}\protected@file@percent }
\newlabel{fig:trust_value_evolution}{{3}{21}{Temporal evolution of mean trust scores for benign (solid) and malicious (dashed) UAVs under $M = 2, 5, 10$ Thinker Agents. Key observations: (1) separation onset delays with more agents but final margin increases; (2) dormant attackers (switching at ${\sim }1300$~s) lose ${\sim }1.5$ trust units within 600~s; (3) after 3500~s, all configurations reach quasi-steady-state with residual fluctuation $\pm 0.3$ due to mobility-induced observation gaps}{figure.caption.6}{}}
\newlabel{fig:trust_value_evolution@cref}{{[figure][3][]3}{[1][20][]21}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces (a) Detection accuracy vs.\ malicious-node ratio: ICA-aggregated scores (solid red) degrade by only 4.7~pp from 5\% to 50\% malicious ratio, while the best single branch (T2, dashed blue) degrades by 18.3~pp, demonstrating that multi-factor aggregation with learned weights is increasingly valuable under severe adversarial conditions. (b) Trust scores under three attack patterns: constant attackers (red) diverge within 500~s; dormant attackers (orange) decline after the switch at ${\sim }1300$~s with no rapid recovery; on-off attackers (green) oscillate but with asymmetric degradation--recovery rates. (c) TSR comparison at 30\% malicious ratio: MTIM's incentive co-optimization yields a 7.9~pp TSR advantage over GDM-DTM despite only a 1.8$\times $ communication-overhead increase.}}{21}{figure.caption.7}\protected@file@percent }
\newlabel{fig:Fig5_energy_consumption}{{4}{21}{(a) Detection accuracy vs.\ malicious-node ratio: ICA-aggregated scores (solid red) degrade by only 4.7~pp from 5\% to 50\% malicious ratio, while the best single branch (T2, dashed blue) degrades by 18.3~pp, demonstrating that multi-factor aggregation with learned weights is increasingly valuable under severe adversarial conditions. (b) Trust scores under three attack patterns: constant attackers (red) diverge within 500~s; dormant attackers (orange) decline after the switch at ${\sim }1300$~s with no rapid recovery; on-off attackers (green) oscillate but with asymmetric degradation--recovery rates. (c) TSR comparison at 30\% malicious ratio: MTIM's incentive co-optimization yields a 7.9~pp TSR advantage over GDM-DTM despite only a 1.8$\times $ communication-overhead increase}{figure.caption.7}{}}
\newlabel{fig:Fig5_energy_consumption@cref}{{[figure][4][]4}{[1][20][]21}{}{}{}}
